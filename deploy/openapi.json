                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/run": {
      "post": {
        "summary": "Resume or run an existing session",
        "parameters": [
          {
            "$ref": "#/components/parameters/session_id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response",
