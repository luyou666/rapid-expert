                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/approve": {
      "post": {
        "summary": "Approve a gated tool for a job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Object"
                }
              }
            }
          },
          "400": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
