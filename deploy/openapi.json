    "/jobs/{job_id}/cancel": {
      "post": {
        "summary": "Cancel non-running job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
