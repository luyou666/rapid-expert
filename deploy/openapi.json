  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "HarnessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Harness-Token"
      }
    },
    "parameters": {
      "session_id": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "job_id": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "tool_name": {
        "name": "tool_name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Object": {
        "type": "object"
      },
      "Task": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Rapid Expert Harness Task",
        "type": "object",
        "required": [
          "domain",
          "goal"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 120
          },
          "question": {
            "type": "string",
            "maxLength": 4000
          },
          "goal": {
            "type": "string",
            "maxLength": 4000
          },
          "user_level": {
            "type": "string",
            "maxLength": 120
          },
          "daily_time": {
            "type": "string",
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "maxLength": 120
          },
          "time_range": {
            "type": "string",
            "maxLength": 120
          },
          "no_network": {
            "type": "boolean"
          },
          "github_query": {
            "type": "string",
            "maxLength": 300
          },
          "min_stars": {
            "type": "integer"
          },
          "github_limit": {
            "type": "integer"
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "session_id": {
            "type": "string"
          },
          "resume": {
            "type": "boolean"
          },
          "from_step": {
            "type": "string"
          },
          "to_step": {
            "type": "string"
          }
        }
      },
      "StepRequest": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "ApproveRequest": {
        "type": "object",
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string"
          }
        }
      },
      "RunAllRequest": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}