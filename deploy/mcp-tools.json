{
  "tools": [
    {
      "name": "rapid_expert_run",
      "description": "Run the Rapid Expert Harness loop for a task.",
      "inputSchema": {
        "type": "object",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "object",
            "required": [
              "domain",
              "goal"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "maxLength": 120
              },
              "goal": {
                "type": "string",
                "maxLength": 4000
              },
              "question": {
                "type": "string",
                "maxLength": 4000
              },
              "user_level": {
                "type": "string",
                "maxLength": 120
              },
              "daily_time": {
                "type": "string",
                "maxLength": 120
              },
              "region": {
                "type": "string",
                "maxLength": 120
              },
              "time_range": {
                "type": "string",
                "maxLength": 120
              },
              "no_network": {
                "type": "boolean"
              },
              "github_query": {
                "type": "string",
                "maxLength": 300
              },
              "min_stars": {
                "type": "integer"
              },
              "github_limit": {
                "type": "integer"
              }
            }
          },
          "session_id": {
            "type": "string"
          },
          "resume": {
            "type": "boolean"
          },
          "from_step": {
            "type": "string",
            "enum": [
              "risk",
              "plan",
              "scan",
              "rank",
              "rag_index",
              "github_search",
              "build",
              "evaluate"
            ]
          },
          "to_step": {
            "type": "string",
            "enum": [
              "risk",
              "plan",
              "scan",
              "rank",
              "rag_index",
              "github_search",
              "build",
              "evaluate"
            ]
          }
        }
      }
    },
