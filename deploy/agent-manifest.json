{
  "name": "rapid-expert-mvp",
  "version": "0.9.1",
  "license": "MIT",
  "description": "Interactive CLI/domain learning agent for 5-12 day practical business execution.",
  "disclaimer": "For learning, research, source organization, and workflow assistance only. Not professional advice.",
  "runtime": {
    "python": ">=3.10",
    "dependencies": "stdlib-only",
    "entrypoint": "scripts/harness.py",
    "legacy_entrypoint": "scripts/rapid_expert.py",
    "http_entrypoint": "scripts/harness_server.py",
    "mcp_stdio_entrypoint": "scripts/harness_mcp.py",
    "queue_entrypoint": "scripts/harness_queue.py"
  },
  "commands": {
    "harness_run": ["python", "scripts/harness.py", "run", "--task", "<task.json>", "--session-id", "<session_id>"],
    "harness_status": ["python", "scripts/harness.py", "status", "--session-id", "<session_id>"],
    "harness_step": ["python", "scripts/harness.py", "step", "--task", "<task.json>", "--session-id", "<session_id>", "--name", "<tool_name>"],
    "harness_server": ["python", "scripts/harness_server.py", "--host", "127.0.0.1", "--port", "8765"],
    "harness_mcp": ["python", "scripts/harness_mcp.py"],
    "queue_submit": ["python", "scripts/harness_queue.py", "submit", "--task", "<task.json>"],
    "queue_run_next": ["python", "scripts/harness_queue.py", "run-next"],
    "queue_worker": ["python", "scripts/harness_queue.py", "worker", "--stop-when-empty"],
    "queue_run_all": ["python", "scripts/harness_queue.py", "run-all"],
    "queue_status": ["python", "scripts/harness_queue.py", "status", "--job-id", "<job_id>"],
    "queue_approve": ["python", "scripts/harness_queue.py", "approve", "--job-id", "<job_id>", "--tool", "<tool_name>"],
    "queue_cancel": ["python", "scripts/harness_queue.py", "cancel", "--job-id", "<job_id>"],
    "queue_retry": ["python", "scripts/harness_queue.py", "retry", "--job-id", "<job_id>"],
    "health": ["python", "scripts/harness_diag.py", "health"],
    "metrics": ["python", "scripts/harness_diag.py", "metrics"],
    "export_package": ["python", "scripts/harness_diag.py", "export", "--output", "dist/rapid-expert-harness.zip"],
    "write_contracts": ["python", "scripts/harness_contract.py", "write"],
    "rag_index_build": ["python", "scripts/rag_index.py", "build", "--sources", "outputs/sources_ranked.json", "--output", "outputs/rag_index.json"],
    "rag_index_search": ["python", "scripts/rag_index.py", "search", "--index", "outputs/rag_index.json", "--query", "<query>"],
    "risk": ["python", "scripts/rapid_expert.py", "risk", "--domain", "<domain>", "--question", "<question>"],
    "plan": ["python", "scripts/rapid_expert.py", "plan", "--domain", "<domain>", "--user-level", "<level>", "--daily-time", "<time>", "--goal", "<goal>"],
    "scan": ["python", "scripts/rapid_expert.py", "scan", "--domain", "<domain>", "--question", "<question>", "--safe-mode", "--output", "outputs/sources_raw.json"],
    "rank": ["python", "scripts/rapid_expert.py", "rank", "--input", "outputs/sources_raw.json", "--output", "outputs/sources_ranked.json"],
    "build": ["python", "scripts/rapid_expert.py", "build", "--domain", "<domain>", "--sources", "outputs/sources_ranked.json", "--duration", "<5|7|9|12>", "--output", "outputs/domain_kit_report.md"],
    "evaluate": ["python", "scripts/rapid_expert.py", "evaluate", "--report", "outputs/domain_kit_report.md", "--sources", "outputs/sources_ranked.json", "--output", "outputs/evaluation.json"],
    "github_search": ["python", "scripts/rapid_expert.py", "github-search", "--query", "<query>", "--output", "outputs/github_projects.json"]
  },
  "harness_task_schema": "harness/schemas/task.schema.json",
  "openapi_contract": "deploy/openapi.json",
  "mcp_tools_contract": "deploy/mcp-tools.json",
  "permission_profile": "harness/config/permission_profile.json",
  "state_schema": "state/schemas/session-state.schema.json",
  "source_schema": "state/schemas/source.schema.json",
  "evaluation_schema": "state/schemas/evaluation.schema.json",
  "safety_policy": "safety/high-risk-domain-policy.md"
}
