{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rapid Expert Evaluation",
  "type": "object",
  "required": ["score", "status", "checks"],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": ["pass", "conditional_pass", "fail"]
    },
    "checks": {
      "type": "object"
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

