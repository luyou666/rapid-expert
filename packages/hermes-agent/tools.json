      "argv_prefix": ["python", "../../scripts/harness_queue.py"],
      "commands": ["submit", "status", "list", "run-next", "run-all", "approve"]
    },
    {
      "name": "rapid_expert_rag",
      "argv_prefix": ["python", "../../scripts/rag_index.py"],
      "commands": ["build", "search"]
    },
    {
      "name": "rapid_expert_diag",
      "argv_prefix": ["python", "../../scripts/harness_diag.py"],
      "commands": ["health", "metrics", "export"]
    },
    {
      "name": "rapid_expert_contracts",
      "argv_prefix": ["python", "../../scripts/harness_contract.py"],
      "commands": ["write", "openapi", "mcp-tools"]
    },
    {
      "name": "rapid_expert_cli",
      "argv_prefix": ["python", "../../scripts/rapid_expert.py"],
      "commands": ["risk", "plan", "scan", "rank", "build", "evaluate", "github-search"]
    }
